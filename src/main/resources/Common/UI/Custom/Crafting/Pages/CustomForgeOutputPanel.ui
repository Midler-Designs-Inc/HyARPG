$Common = "../../Common.ui";

@OutputSlotBackground = (TexturePath: "../../Slot.png", Border: 4);

@OutputPanel = Group {
    LayoutMode: Top;
    Anchor: (Width: 222, Left: 8);

    Group {
        Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
        FlexWeight: 1;

        Group {
            LayoutMode: Top;
            Anchor: (Full: 0);

            Label #OutputNameLabel {
                Style: (FontSize: 12, RenderBold: true, TextColor: #cfd6e0, Alignment: Center, RenderUppercase: true, FontName: "Secondary");
                Anchor: (Top: 8, Height: 24);
                Padding: (Horizontal: 8);
            }

            // output slot centered horizontally
            Group #OutputSlotWrapper {
                Anchor: (Height: 74, Top: 12, Horizontal: 0);
                LayoutMode: Center;

                Group #OutputSlot {
                    Anchor: (Width: 74, Height: 74);
                    Background: @OutputSlotBackground;

                    ItemSlot #OutputItem {
                        Anchor: (Width: 64, Height: 64);
                        ShowQualityBackground: true;
                        ShowQuantity: false;
                    }
                }
            }

           // weapon stats — only visible when output slot has an item
           Group #WeaponStats {
               Visible: false;
               LayoutMode: Top;
               Anchor: (Horizontal: 8, Top: 10);

               // separator
               Group {
                   Background: #9c8863(0.2);
                   Anchor: (Height: 1, Bottom: 6);
               }

               // weapon type and hand requirement e.g. "Axe (1H)"
               Label #WeaponType {
                   Anchor: (Top: 6);
                   Style: (FontSize: 11, TextColor: #ffffff, RenderBold: true, RenderUppercase: true);
               }

               // base weapon damage from primary slot e.g. "5 Physical Damage"
               Label #WeaponDamage {
                   Anchor: (Top: 2);
                   Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true);
               }

               // separator before implicits
               Group {
                   Background: #9c8863(0.1);
                   Anchor: (Height: 1, Top: 8, Bottom: 4);
               }

               // implicit stat lines — max 5 (slot 0 remaining + slot 1 + slot 2)
               Label #ImplicitLine1 { Anchor: (Top: 4); Style: (FontSize: 12, TextColor: #aaaaaa, Wrap: true); }
               Label #ImplicitLine2 { Anchor: (Top: 3); Style: (FontSize: 12, TextColor: #aaaaaa, Wrap: true); }
               Label #ImplicitLine3 { Anchor: (Top: 3); Style: (FontSize: 12, TextColor: #aaaaaa, Wrap: true); }
               Label #ImplicitLine4 { Anchor: (Top: 3); Style: (FontSize: 12, TextColor: #aaaaaa, Wrap: true); }
               Label #ImplicitLine5 { Anchor: (Top: 3); Style: (FontSize: 12, TextColor: #aaaaaa, Wrap: true); }
               Label #ImplicitLine5Empty { Anchor: (Top: 3); Style: (FontSize: 12, TextColor: #8a9bb0, Wrap: true); }
               Label #AffixCount { Anchor: (Top: 3); Style: (FontSize: 12, TextColor: #bca57a, Wrap: true, RenderBold: true); }
           }

           Group { FlexWeight: 1; }

           $Common.@TextButton #CraftButton {
               @Text = "CRAFT";
               @Anchor = (Horizontal: 8, Bottom: 8);
               Disabled: true;
           }

            Group #ProgressBarContainer {
                Anchor: (Height: 4, Horizontal: 8, Bottom: 8);
                Background: #060c12;
                ProgressBar #ProgressBar {
                    BarTexturePath: "../../Common/ProgressBarFill.png";
                    EffectTexturePath: "../../Common/ProgressBarEffect.png";
                    EffectWidth: 53;
                    EffectHeight: 30;
                    EffectOffset: 38;
                }
            }
        }
    }
};