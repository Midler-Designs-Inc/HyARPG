 @ItemIconStyle = (
   Default: (Background: (TexturePath: "../../Common/HeaderTabSelectedBackground.png", Border: 7)),
   Hovered: (Background: (TexturePath: "../../Common/HeaderTabSelectedBackground.png", Border: 7, Color: #ffffff(0.8))),
   Pressed: (Background: (TexturePath: "../../Common/HeaderTabSelectedBackground.png", Border: 7, Color: #ffffff(0.6)))
 );

 @SubCategoryTabsCloth = Group {
    LayoutMode: Left;
    Anchor: (Height: 52, Bottom: 8);
    Visible: false;
     
    Button #IconClothHelmet {
        Anchor: (Width: 44, Height: 44, Right: 8); Style: @ItemIconStyle;
        TooltipText: "Helmet";

        Group #IconClothHelmetOverlay {Anchor: (Full: 0); Background: (TexturePath: "../../DiagramCraftingSlotActive.png", Border: 7); Visible: false; }
        Group {Anchor: (Width: 32, Height: 32); Background: "../Icons/Armor_Cloth_Cotton_Head.png"; }
    }
    Button #IconClothChest {
        Anchor: (Width: 44, Height: 44, Right: 8); Style: @ItemIconStyle;
        TooltipText: "Chest";

        Group #IconClothChestOverlay {Anchor: (Full: 0); Background: (TexturePath: "../../DiagramCraftingSlotActive.png", Border: 7); Visible: true; }
        Group {Anchor: (Width: 32, Height: 32); Background: "../Icons/Armor_Cloth_Cotton_Chest.png"; }
    }
    Button #IconClothGloves {
        Anchor: (Width: 44, Height: 44, Right: 8); Style: @ItemIconStyle;
        TooltipText: "Gloves";

        Group #IconClothGlovesOverlay {Anchor: (Full: 0); Background: (TexturePath: "../../DiagramCraftingSlotActive.png", Border: 7); Visible: true; }
        Group {Anchor: (Width: 32, Height: 32); Background: "../Icons/Armor_Cloth_Cotton_Hands.png"; }
    }
    Button #IconClothPants {
        Anchor: (Width: 44, Height: 44); Style: @ItemIconStyle;
        TooltipText: "Pants";

        Group #IconClothPantsOverlay {Anchor: (Full: 0); Background: (TexturePath: "../../DiagramCraftingSlotActive.png", Border: 7); Visible: true; }
        Group {Anchor: (Width: 32, Height: 32); Background: "../Icons/Armor_Cloth_Cotton_Legs.png"; }
    }
};