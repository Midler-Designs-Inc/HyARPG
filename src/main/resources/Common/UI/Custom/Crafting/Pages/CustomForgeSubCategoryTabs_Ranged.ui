@ItemIconStyle = (
   Default: (Background: (TexturePath: "../../Common/HeaderTabSelectedBackground.png", Border: 7)),
   Hovered: (Background: (TexturePath: "../../Common/HeaderTabSelectedBackground.png", Border: 7, Color: #ffffff(0.8))),
   Pressed: (Background: (TexturePath: "../../Common/HeaderTabSelectedBackground.png", Border: 7, Color: #ffffff(0.6)))
 );

@SubCategoryTabsRanged = Group {
    LayoutMode: Left;
    Anchor: (Height: 52, Bottom: 8);
    Visible: false;

    Button #IconCrossbow {
        Anchor: (Width: 44, Height: 44, Right: 8); Style: @ItemIconStyle;
        TooltipText: "Crossbow";

        Group #IconCrossbowOverlay {Anchor: (Full: 0); Background: (TexturePath: "../../DiagramCraftingSlotActive.png", Border: 7); Visible: false; }
        Group {Anchor: (Width: 32, Height: 32); Background: "../Icons/Weapon_Crossbow_Iron.png"; }
    }
    Button #IconKunai {
        Anchor: (Width: 44, Height: 44, Right: 8); Style: @ItemIconStyle;
        TooltipText: "Kunai";

        Group #IconKunaiOverlay {Anchor: (Full: 0); Background: (TexturePath: "../../DiagramCraftingSlotActive.png", Border: 7); Visible: true; }
        Group {Anchor: (Width: 32, Height: 32); Background: "../Icons/Weapon_Kunai.png"; }
    }
    Button #IconLongbow {
        Anchor: (Width: 44, Height: 44, Right: 8); Style: @ItemIconStyle;
        TooltipText: "Longbow";

        Group #IconLongbowOverlay {Anchor: (Full: 0); Background: (TexturePath: "../../DiagramCraftingSlotActive.png", Border: 7); Visible: true; }
        Group {Anchor: (Width: 32, Height: 32); Background: "../Icons/Weapon_Longbow_Iron.png"; }
    }
    Button #IconShortbow {
        Anchor: (Width: 44, Height: 44); Style: @ItemIconStyle;
        TooltipText: "Shortbow";

        Group #IconShortbowOverlay {Anchor: (Full: 0); Background: (TexturePath: "../../DiagramCraftingSlotActive.png", Border: 7); Visible: true; }
        Group {Anchor: (Width: 32, Height: 32); Background: "../Icons/Weapon_Bow_Iron.png"; }
    }
};