@CubeInputSlots = Group {
    Anchor: (Height: 460);
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Horizontal: 8, Top: 8);

    // 3x3 input grid — centered in the panel, items placed here are ingredients for the combine
    Group {
        LayoutMode: Center;
        Anchor: (Full: 0);

        Group {
            LayoutMode: Top;

            // Row 0 — slots 0-2
            Group {
                LayoutMode: Left;
                Anchor: (Height: 74, Bottom: 4);

                ItemSlotButton #CubeSlot0 { Anchor: (Width: 74, Height: 74, Right: 4);
                    ItemSlot #CubeSlotItem0 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; }
                    Group #CubeSlotInUseOverlay0 { Anchor: (Full: 0); Visible: false; Background: #000000(0.5); }
                    Label #CubeSlotQty0 { Anchor: (Full: 0); Visible: false; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true, Alignment: End, VerticalAlignment: End); Padding: (Right: 6, Bottom: 6); }
                }
                ItemSlotButton #CubeSlot1 { Anchor: (Width: 74, Height: 74, Right: 4);
                    ItemSlot #CubeSlotItem1 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; }
                    Group #CubeSlotInUseOverlay1 { Anchor: (Full: 0); Visible: false; Background: #000000(0.5); }
                    Label #CubeSlotQty1 { Anchor: (Full: 0); Visible: false; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true, Alignment: End, VerticalAlignment: End); Padding: (Right: 6, Bottom: 6); }
                }
                ItemSlotButton #CubeSlot2 { Anchor: (Width: 74, Height: 74);
                    ItemSlot #CubeSlotItem2 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; }
                    Group #CubeSlotInUseOverlay2 { Anchor: (Full: 0); Visible: false; Background: #000000(0.5); }
                    Label #CubeSlotQty2 { Anchor: (Full: 0); Visible: false; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true, Alignment: End, VerticalAlignment: End); Padding: (Right: 6, Bottom: 6); }
                }
            }

            // Row 1 — slots 3-5
            Group {
                LayoutMode: Left;
                Anchor: (Height: 74, Bottom: 4);

                ItemSlotButton #CubeSlot3 { Anchor: (Width: 74, Height: 74, Right: 4);
                    ItemSlot #CubeSlotItem3 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; }
                    Group #CubeSlotInUseOverlay3 { Anchor: (Full: 0); Visible: false; Background: #000000(0.5); }
                    Label #CubeSlotQty3 { Anchor: (Full: 0); Visible: false; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true, Alignment: End, VerticalAlignment: End); Padding: (Right: 6, Bottom: 6); }
                }
                ItemSlotButton #CubeSlot4 { Anchor: (Width: 74, Height: 74, Right: 4);
                    ItemSlot #CubeSlotItem4 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; }
                    Group #CubeSlotInUseOverlay4 { Anchor: (Full: 0); Visible: false; Background: #000000(0.5); }
                    Label #CubeSlotQty4 { Anchor: (Full: 0); Visible: false; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true, Alignment: End, VerticalAlignment: End); Padding: (Right: 6, Bottom: 6); }
                }
                ItemSlotButton #CubeSlot5 { Anchor: (Width: 74, Height: 74);
                    ItemSlot #CubeSlotItem5 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; }
                    Group #CubeSlotInUseOverlay5 { Anchor: (Full: 0); Visible: false; Background: #000000(0.5); }
                    Label #CubeSlotQty5 { Anchor: (Full: 0); Visible: false; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true, Alignment: End, VerticalAlignment: End); Padding: (Right: 6, Bottom: 6); }
                }
            }

            // Row 2 — slots 6-8
            Group {
                LayoutMode: Left;
                Anchor: (Height: 74);

                ItemSlotButton #CubeSlot6 { Anchor: (Width: 74, Height: 74, Right: 4);
                    ItemSlot #CubeSlotItem6 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; }
                    Group #CubeSlotInUseOverlay6 { Anchor: (Full: 0); Visible: false; Background: #000000(0.5); }
                    Label #CubeSlotQty6 { Anchor: (Full: 0); Visible: false; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true, Alignment: End, VerticalAlignment: End); Padding: (Right: 6, Bottom: 6); }
                }
                ItemSlotButton #CubeSlot7 { Anchor: (Width: 74, Height: 74, Right: 4);
                    ItemSlot #CubeSlotItem7 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; }
                    Group #CubeSlotInUseOverlay7 { Anchor: (Full: 0); Visible: false; Background: #000000(0.5); }
                    Label #CubeSlotQty7 { Anchor: (Full: 0); Visible: false; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true, Alignment: End, VerticalAlignment: End); Padding: (Right: 6, Bottom: 6); }
                }
                ItemSlotButton #CubeSlot8 { Anchor: (Width: 74, Height: 74);
                    ItemSlot #CubeSlotItem8 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; }
                    Group #CubeSlotInUseOverlay8 { Anchor: (Full: 0); Visible: false; Background: #000000(0.5); }
                    Label #CubeSlotQty8 { Anchor: (Full: 0); Visible: false; Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true, Alignment: End, VerticalAlignment: End); Padding: (Right: 6, Bottom: 6); }
                }
            }
        }
    }
};
