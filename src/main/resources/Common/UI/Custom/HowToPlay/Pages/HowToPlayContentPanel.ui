$Common = "../../Common.ui";

@HowToPlayContentPanel = Group {
    LayoutMode: Top;
    FlexWeight: 1;

    Group {
        Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
        FlexWeight: 1;

        Group {
            LayoutMode: Top;
            Anchor: (Full: 0);

            // section title
            Label #HTPSectionTitle {
                Style: (FontSize: 16, RenderBold: true, TextColor: #c8a84b, RenderUppercase: true);
                Anchor: (Top: 10, Left: 12, Right: 12, Height: 24);
            }

            // separator under title
            Group {
                Background: #9c8863(0.3);
                Anchor: (Height: 1, Top: 6, Bottom: 6, Horizontal: 12);
            }

            // scrolling content area with native scrollbar style
            Group {
                LayoutMode: TopScrolling;
                ScrollbarStyle: $Common.@DefaultScrollbarStyle;
                FlexWeight: 1;
                Anchor: (Horizontal: 0);

                Group {
                    LayoutMode: Top;
                    Anchor: (Horizontal: 12, Top: 8, Bottom: 8);

                    Label #HTPLine1  { Anchor: (Top: 2); Style: (FontSize: 13, TextColor: #cccccc, Wrap: true); }
                    Label #HTPLine2  { Anchor: (Top: 2); Style: (FontSize: 13, TextColor: #cccccc, Wrap: true); }
                    Label #HTPLine3  { Anchor: (Top: 2); Style: (FontSize: 13, TextColor: #cccccc, Wrap: true); }
                    Label #HTPLine4  { Anchor: (Top: 2); Style: (FontSize: 13, TextColor: #cccccc, Wrap: true); }
                    Label #HTPLine5  { Anchor: (Top: 2); Style: (FontSize: 13, TextColor: #cccccc, Wrap: true); }
                    Label #HTPLine6  { Anchor: (Top: 2); Style: (FontSize: 13, TextColor: #cccccc, Wrap: true); }
                    Label #HTPLine7  { Anchor: (Top: 2); Style: (FontSize: 13, TextColor: #cccccc, Wrap: true); }
                    Label #HTPLine8  { Anchor: (Top: 2); Style: (FontSize: 13, TextColor: #cccccc, Wrap: true); }
                    Label #HTPLine9  { Anchor: (Top: 2); Style: (FontSize: 13, TextColor: #cccccc, Wrap: true); }
                    Label #HTPLine10 { Anchor: (Top: 2); Style: (FontSize: 13, TextColor: #cccccc, Wrap: true); }
