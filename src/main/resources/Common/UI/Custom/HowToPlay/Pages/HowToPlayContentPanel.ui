$Common = "../../Common.ui";

@HowToPlayContentPanel = Group {
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Left: 16, Top: 16, Right: 16, Bottom: 16);

    // section title
    Label #HTPSectionTitle {
        Style: (FontSize: 18, RenderBold: true, TextColor: #c8a84b, RenderUppercase: true);
        Anchor: (Bottom: 10, Height: 24);
    }

    // separator under title
    Group {
        Background: #9c8863(0.3);
        Anchor: (Height: 1, Bottom: 12);
    }

    // scrolling content area with translucent scrollbar matching UI gallery
    Group {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $Common.@DefaultScrollbarStyle;
        FlexWeight: 1;

        Group {
            LayoutMode: Top;
            Anchor: (Right: 16, Top: 4, Bottom: 4);

            Label #HTPLine1  { Anchor: (Top: 2); Style: (FontSize: 13, TextColor: #cccccc, Wrap: true); }
            Label #HTPLine2  { Anchor: (Top: 2); Style: (FontSize: 13, TextColor: #cccccc, Wrap: true); }
            Label #HTPLine3  { Anchor: (Top: 2); Style: (FontSize: 13, TextColor: #cccccc, Wrap: true); }
