$Common = "Common.ui";
$NavPanel = "HowToPlay/Pages/HowToPlayNavPanel.ui";
$ContentPanel = "HowToPlay/Pages/HowToPlayContentPanel.ui";

SceneBlur {}

Group {
    Background: #000000(0.55);
}

Group {
    LayoutMode: Center;

    Group {
        Anchor: (Width: 1060);
        LayoutMode: Top;
        Padding: (Top: 15);

        // use @Container with built-in close button
        $Common.@Container #HowToPlayPanel {
            @CloseButton = true;

            #Title {
                LayoutMode: Left;
                Padding: (Left: 20, Top: 0, Bottom: 0);

                Label {
                    Text: "HOW TO PLAY";
                    Style: (...$Common.@TitleStyle, TextColor: #5a8ab0, VerticalAlignment: Center);
                    Anchor: (Height: 38);
                }

                Group { FlexWeight: 1; }
            }

            #Content {
                LayoutMode: Left;
                Anchor: (Height: 580);
                Padding: (Left: 8, Top: 8, Bottom: 8, Right: 8);

                // Left — section nav
                $NavPanel.@HowToPlayNavPanel #HTPNav {}

                // Spacer
                Group { Anchor: (Width: 8); }

                // Right — scrolling content
                $ContentPanel.@HowToPlayContentPanel #HTPContent {}
            }
        }
    }
}
