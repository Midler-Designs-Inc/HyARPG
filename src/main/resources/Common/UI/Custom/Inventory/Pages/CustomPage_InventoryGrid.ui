$Common = "../../Common.ui";


@InvSlotSelectedBackground = (TexturePath: "../../HyARPG_Selected_Item.png", Border: 4);
@GearSlotSelectedBG        = (TexturePath: "../../HyARPG_Selected_Item.png", Border: 4);
@GearSlotActiveUtilityBG   = (TexturePath: "../../Common/TabSelectedOverlay.png", Border: 0);

@GearSlotBGHead  = (TexturePath: "../Icons/HyARPG_Gear_Slot_Helmet.png",  Border: 4);
@GearSlotBGChest = (TexturePath: "../Icons/HyARPG_Gear_Slot_Chest.png", Border: 4);
@GearSlotBGHands = (TexturePath: "../Icons/HyARPG_Gear_Slot_Hands.png", Border: 4);
@GearSlotBGLegs  = (TexturePath: "../Icons/HyARPG_Gear_Slot_Legs.png",  Border: 4);

@GearSlotStyleHead  = (Default: (Background: @GearSlotBGHead),  Hovered: (Background: @GearSlotBGHead),  Pressed: (Background: @GearSlotBGHead));
@GearSlotStyleChest = (Default: (Background: @GearSlotBGChest), Hovered: (Background: @GearSlotBGChest), Pressed: (Background: @GearSlotBGChest));
@GearSlotStyleHands = (Default: (Background: @GearSlotBGHands), Hovered: (Background: @GearSlotBGHands), Pressed: (Background: @GearSlotBGHands));
@GearSlotStyleLegs  = (Default: (Background: @GearSlotBGLegs),  Hovered: (Background: @GearSlotBGLegs),  Pressed: (Background: @GearSlotBGLegs));

@InventoryGrid = Group {
    LayoutMode: Top;
    Padding: (Horizontal: 8);

    // Armor slots — 2x2 grid above the inventory
    Group {
        LayoutMode: Top;
        Anchor: (Bottom: 6);

        Label { Text: "ARMOR"; Style: (FontSize: 11, RenderBold: true, TextColor: #888888, RenderUppercase: true); Anchor: (Bottom: 6); }

        Group { LayoutMode: Left; Anchor: (Bottom: 4);
            Button #ArmorSlot0 {Anchor: (Width: 74, Height: 74, Right: 4);
                ItemSlot #ArmorItem0 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: false; }
                Group #ArmorSelectedOverlay0 { Anchor: (Full: 0); Visible: false; Background: @GearSlotSelectedBG; }
                Group #ArmorValidOverlay0    { Anchor: (Full: 0); Visible: false; Background: #002200(0.4); }
                Group #ArmorInvalidOverlay0  { Anchor: (Full: 0); Visible: false; Background: #220000(0.4); }
                Group { Anchor: (Width: 44, Height: 44, Top: 15, Left: 15); Background: @GearSlotBGHead; }
            }
            Button #ArmorSlot1 { Anchor: (Width: 74, Height: 74, Right: 4);
                ItemSlot #ArmorItem1 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: false; }
                Group #ArmorSelectedOverlay1 { Anchor: (Full: 0); Visible: false; Background: @GearSlotSelectedBG; }
                Group #ArmorValidOverlay1    { Anchor: (Full: 0); Visible: false; Background: #002200(0.4); }
                Group #ArmorInvalidOverlay1  { Anchor: (Full: 0); Visible: false; Background: #220000(0.4); }
                Group { Anchor: (Width: 44, Height: 44, Top: 15, Left: 15); Background: @GearSlotBGChest; }
            }
            Button #ArmorSlot2 { Anchor: (Width: 74, Height: 74, Right: 4);
                ItemSlot #ArmorItem2 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: false; }
                Group #ArmorSelectedOverlay2 { Anchor: (Full: 0); Visible: false; Background: @GearSlotSelectedBG; }
                Group #ArmorValidOverlay2    { Anchor: (Full: 0); Visible: false; Background: #002200(0.4); }
                Group #ArmorInvalidOverlay2  { Anchor: (Full: 0); Visible: false; Background: #220000(0.4); }
                Group { Anchor: (Width: 44, Height: 44, Top: 15, Left: 15); Background: @GearSlotBGHands; }
            }
            Button #ArmorSlot3 { Anchor: (Width: 74, Height: 74);
                ItemSlot #ArmorItem3 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: false; }
                Group #ArmorSelectedOverlay3 { Anchor: (Full: 0); Visible: false; Background: @GearSlotSelectedBG; }
                Group #ArmorValidOverlay3    { Anchor: (Full: 0); Visible: false; Background: #002200(0.4); }
                Group #ArmorInvalidOverlay3  { Anchor: (Full: 0); Visible: false; Background: #220000(0.4); }
                Group { Anchor: (Width: 44, Height: 44, Top: 15, Left: 15); Background: @GearSlotBGLegs; }
            }
        }
    }

    // Utility slots — row of 5 below armor
    Group {
        LayoutMode: Top;
        Anchor: (Bottom: 10);

        Label { Text: "UTILITY"; Style: (FontSize: 11, RenderBold: true, TextColor: #888888, RenderUppercase: true); Anchor: (Bottom: 6); }

        Group {
            LayoutMode: Left;

            Button #UtilitySlot0 { Anchor: (Width: 56, Height: 56, Right: 3);
                ItemSlot #UtilityItem0 { Anchor: (Width: 48, Height: 48); ShowQualityBackground: true; ShowQuantity: false; }
                Group #UtilitySelectedOverlay0 { Anchor: (Full: 0); Visible: false; Background: @GearSlotSelectedBG; }
                Group #UtilityActiveOverlay0   { Anchor: (Full: 0); Visible: false; Background: @GearSlotActiveUtilityBG; }
                Group #UtilityValidOverlay0    { Anchor: (Full: 0); Visible: false; Background: #002200(0.4); }
                Group #UtilityInvalidOverlay0  { Anchor: (Full: 0); Visible: false; Background: #220000(0.4); }
            }
            Button #UtilitySlot1 { Anchor: (Width: 56, Height: 56, Right: 3);
                ItemSlot #UtilityItem1 { Anchor: (Width: 48, Height: 48); ShowQualityBackground: true; ShowQuantity: false; }
                Group #UtilitySelectedOverlay1 { Anchor: (Full: 0); Visible: false; Background: @GearSlotSelectedBG; }
                Group #UtilityActiveOverlay1   { Anchor: (Full: 0); Visible: false; Background: @GearSlotActiveUtilityBG; }
                Group #UtilityValidOverlay1    { Anchor: (Full: 0); Visible: false; Background: #002200(0.4); }
                Group #UtilityInvalidOverlay1  { Anchor: (Full: 0); Visible: false; Background: #220000(0.4); }
            }
            Button #UtilitySlot2 { Anchor: (Width: 56, Height: 56, Right: 3);
                ItemSlot #UtilityItem2 { Anchor: (Width: 48, Height: 48); ShowQualityBackground: true; ShowQuantity: false; }
                Group #UtilitySelectedOverlay2 { Anchor: (Full: 0); Visible: false; Background: @GearSlotSelectedBG; }
                Group #UtilityActiveOverlay2   { Anchor: (Full: 0); Visible: false; Background: @GearSlotActiveUtilityBG; }
                Group #UtilityValidOverlay2    { Anchor: (Full: 0); Visible: false; Background: #002200(0.4); }
                Group #UtilityInvalidOverlay2  { Anchor: (Full: 0); Visible: false; Background: #220000(0.4); }
            }
            Button #UtilitySlot3 { Anchor: (Width: 56, Height: 56, Right: 3);
                ItemSlot #UtilityItem3 { Anchor: (Width: 48, Height: 48); ShowQualityBackground: true; ShowQuantity: false; }
                Group #UtilitySelectedOverlay3 { Anchor: (Full: 0); Visible: false; Background: @GearSlotSelectedBG; }
                Group #UtilityActiveOverlay3   { Anchor: (Full: 0); Visible: false; Background: @GearSlotActiveUtilityBG; }
                Group #UtilityValidOverlay3    { Anchor: (Full: 0); Visible: false; Background: #002200(0.4); }
                Group #UtilityInvalidOverlay3  { Anchor: (Full: 0); Visible: false; Background: #220000(0.4); }
            }
        }
    }

    // Separator between gear and inventory
    Group { Background: #9c8863(0.2); Anchor: (Height: 1, Bottom: 8); }

    // Storage grid — 36 slots in 4 rows of 9
    Group { LayoutMode: Left; Anchor: (Height: 76, Top: 0);
        Button #InvStorageSlot0  { Anchor: (Width: 74, Height: 74, Right: 2); ItemSlot #InvStorageItem0  { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay0  { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay0  { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
        Button #InvStorageSlot1  { Anchor: (Width: 74, Height: 74, Right: 2); ItemSlot #InvStorageItem1  { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay1  { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay1  { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
        Button #InvStorageSlot2  { Anchor: (Width: 74, Height: 74, Right: 2); ItemSlot #InvStorageItem2  { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay2  { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay2  { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
        Button #InvStorageSlot3  { Anchor: (Width: 74, Height: 74, Right: 2); ItemSlot #InvStorageItem3  { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay3  { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay3  { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
        Button #InvStorageSlot4  { Anchor: (Width: 74, Height: 74, Right: 2); ItemSlot #InvStorageItem4  { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay4  { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay4  { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
        Button #InvStorageSlot5  { Anchor: (Width: 74, Height: 74, Right: 2); ItemSlot #InvStorageItem5  { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay5  { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay5  { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
        Button #InvStorageSlot6  { Anchor: (Width: 74, Height: 74, Right: 2); ItemSlot #InvStorageItem6  { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay6  { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay6  { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
