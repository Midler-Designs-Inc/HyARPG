        Button #InvStorageSlot20 { Anchor: (Width: 74, Height: 74, Right: 2); ItemSlot #InvStorageItem20 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay20 { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay20 { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
