        Button #InvStorageSlot17 { Anchor: (Width: 74, Height: 74);         ItemSlot #InvStorageItem17 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay17 { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay17 { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
