        Button #InvStorageSlot13 { Anchor: (Width: 74, Height: 74, Right: 2); Style: @InvSlotStyle; ItemSlot #InvStorageItem13 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay13 { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay13 { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
        Button #InvStorageSlot14 { Anchor: (Width: 74, Height: 74, Right: 2); Style: @InvSlotStyle; ItemSlot #InvStorageItem14 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay14 { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay14 { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
        Button #InvStorageSlot15 { Anchor: (Width: 74, Height: 74, Right: 2); Style: @InvSlotStyle; ItemSlot #InvStorageItem15 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay15 { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay15 { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
        Button #InvStorageSlot16 { Anchor: (Width: 74, Height: 74, Right: 2); Style: @InvSlotStyle; ItemSlot #InvStorageItem16 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay16 { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay16 { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
