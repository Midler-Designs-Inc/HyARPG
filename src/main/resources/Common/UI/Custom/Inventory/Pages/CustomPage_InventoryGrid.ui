        Button #InvStorageSlot23 { Anchor: (Width: 74, Height: 74, Right: 2); Style: @InvSlotStyle; ItemSlot #InvStorageItem23 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay23 { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay23 { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
