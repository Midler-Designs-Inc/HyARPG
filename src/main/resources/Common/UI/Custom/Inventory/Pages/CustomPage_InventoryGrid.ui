$Common = "../../Common.ui";

@InvSlotBackground         = (TexturePath: "../../Slot.png", Border: 3);
@InvSlotSelectedBackground = (TexturePath: "../../ItemSlotSelected.png", Border: 3);
@InvSlotStyle              = (Default: (Background: @InvSlotBackground), Hovered: (Background: @InvSlotBackground), Pressed: (Background: @InvSlotBackground));
@GearSlotBackground        = (TexturePath: "../../DiagramCraftingSlot.png", Border: 4);
@GearSlotStyle             = (Default: (Background: @GearSlotBackground), Hovered: (Background: @GearSlotBackground), Pressed: (Background: @GearSlotBackground));
@GearSlotSelectedBG        = (TexturePath: "../../ItemSlotSelected.png", Border: 3);
@GearSlotActiveUtilityBG   = (TexturePath: "../../HeaderTabSelectedBackground.png", Border: 4);

@InventoryGrid = Group {
    LayoutMode: Top;
    Padding: (Horizontal: 8);

    // -------------------------------------------------------------------------
    // Armor slots — 2x2 grid above the inventory
    // -------------------------------------------------------------------------
    Group {
        LayoutMode: Top;
        Anchor: (Bottom: 6);

        Label { Text: "ARMOR"; Style: (FontSize: 11, RenderBold: true, TextColor: #888888, RenderUppercase: true); Anchor: (Bottom: 6); }

        Group { LayoutMode: Left; Anchor: (Bottom: 4);
            Button #ArmorSlot0 { Anchor: (Width: 74, Height: 74, Right: 4); Style: @GearSlotStyle;
                ItemSlot #ArmorItem0 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: false; }
                Group #ArmorSelectedOverlay0 { Anchor: (Full: 0); Visible: false; Background: @GearSlotSelectedBG; }
                Group #ArmorValidOverlay0    { Anchor: (Full: 0); Visible: false; Background: #002200(0.4); }
                Group #ArmorInvalidOverlay0  { Anchor: (Full: 0); Visible: false; Background: #220000(0.4); }
                Label { Text: "HEAD";  Style: (FontSize: 9, TextColor: #555555, Alignment: Center); Anchor: (Full: 0); }
            }
            Button #ArmorSlot1 { Anchor: (Width: 74, Height: 74, Right: 4); Style: @GearSlotStyle;
                ItemSlot #ArmorItem1 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: false; }
                Group #ArmorSelectedOverlay1 { Anchor: (Full: 0); Visible: false; Background: @GearSlotSelectedBG; }
                Group #ArmorValidOverlay1    { Anchor: (Full: 0); Visible: false; Background: #002200(0.4); }
                Group #ArmorInvalidOverlay1  { Anchor: (Full: 0); Visible: false; Background: #220000(0.4); }
                Label { Text: "CHEST"; Style: (FontSize: 9, TextColor: #555555, Alignment: Center); Anchor: (Full: 0); }
            }
            Button #ArmorSlot2 { Anchor: (Width: 74, Height: 74, Right: 4); Style: @GearSlotStyle;
                ItemSlot #ArmorItem2 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: false; }
                Group #ArmorSelectedOverlay2 { Anchor: (Full: 0); Visible: false; Background: @GearSlotSelectedBG; }
                Group #ArmorValidOverlay2    { Anchor: (Full: 0); Visible: false; Background: #002200(0.4); }
                Group #ArmorInvalidOverlay2  { Anchor: (Full: 0); Visible: false; Background: #220000(0.4); }
                Label { Text: "HANDS"; Style: (FontSize: 9, TextColor: #555555, Alignment: Center); Anchor: (Full: 0); }
            }
            Button #ArmorSlot3 { Anchor: (Width: 74, Height: 74); Style: @GearSlotStyle;
                ItemSlot #ArmorItem3 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: false; }
                Group #ArmorSelectedOverlay3 { Anchor: (Full: 0); Visible: false; Background: @GearSlotSelectedBG; }
                Group #ArmorValidOverlay3    { Anchor: (Full: 0); Visible: false; Background: #002200(0.4); }
                Group #ArmorInvalidOverlay3  { Anchor: (Full: 0); Visible: false; Background: #220000(0.4); }
                Label { Text: "LEGS"; Style: (FontSize: 9, TextColor: #555555, Alignment: Center); Anchor: (Full: 0); }
            }
        }
    }

    // -------------------------------------------------------------------------
    // Utility slots — row of 5 below armor
    // -------------------------------------------------------------------------
    Group {
        LayoutMode: Top;
        Anchor: (Bottom: 10);

        Label { Text: "UTILITY"; Style: (FontSize: 11, RenderBold: true, TextColor: #888888, RenderUppercase: true); Anchor: (Bottom: 6); }

        Group {
            LayoutMode: Left;

            Button #UtilitySlot0 { Anchor: (Width: 56, Height: 56, Right: 3); Style: @GearSlotStyle;
                ItemSlot #UtilityItem0 { Anchor: (Width: 48, Height: 48); ShowQualityBackground: true; ShowQuantity: false; }
                Group #UtilitySelectedOverlay0 { Anchor: (Full: 0); Visible: false; Background: @GearSlotSelectedBG; }
                Group #UtilityActiveOverlay0   { Anchor: (Full: 0); Visible: false; Background: @GearSlotActiveUtilityBG; }
                Group #UtilityValidOverlay0    { Anchor: (Full: 0); Visible: false; Background: #002200(0.4); }
                Group #UtilityInvalidOverlay0  { Anchor: (Full: 0); Visible: false; Background: #220000(0.4); }
            }
            Button #UtilitySlot1 { Anchor: (Width: 56, Height: 56, Right: 3); Style: @GearSlotStyle;
                ItemSlot #UtilityItem1 { Anchor: (Width: 48, Height: 48); ShowQualityBackground: true; ShowQuantity: false; }
                Group #UtilitySelectedOverlay1 { Anchor: (Full: 0); Visible: false; Background: @GearSlotSelectedBG; }
                Group #UtilityActiveOverlay1   { Anchor: (Full: 0); Visible: false; Background: @GearSlotActiveUtilityBG; }
                Group #UtilityValidOverlay1    { Anchor: (Full: 0); Visible: false; Background: #002200(0.4); }
                Group #UtilityInvalidOverlay1  { Anchor: (Full: 0); Visible: false; Background: #220000(0.4); }
            }
            Button #UtilitySlot2 { Anchor: (Width: 56, Height: 56, Right: 3); Style: @GearSlotStyle;
                ItemSlot #UtilityItem2 { Anchor: (Width: 48, Height: 48); ShowQualityBackground: true; ShowQuantity: false; }
                Group #UtilitySelectedOverlay2 { Anchor: (Full: 0); Visible: false; Background: @GearSlotSelectedBG; }
                Group #UtilityActiveOverlay2   { Anchor: (Full: 0); Visible: false; Background: @GearSlotActiveUtilityBG; }
                Group #UtilityValidOverlay2    { Anchor: (Full: 0); Visible: false; Background: #002200(0.4); }
                Group #UtilityInvalidOverlay2  { Anchor: (Full: 0); Visible: false; Background: #220000(0.4); }
            }
            Button #UtilitySlot3 { Anchor: (Width: 56, Height: 56, Right: 3); Style: @GearSlotStyle;
                ItemSlot #UtilityItem3 { Anchor: (Width: 48, Height: 48); ShowQualityBackground: true; ShowQuantity: false; }
                Group #UtilitySelectedOverlay3 { Anchor: (Full: 0); Visible: false; Background: @GearSlotSelectedBG; }
                Group #UtilityActiveOverlay3   { Anchor: (Full: 0); Visible: false; Background: @GearSlotActiveUtilityBG; }
                Group #UtilityValidOverlay3    { Anchor: (Full: 0); Visible: false; Background: #002200(0.4); }
                Group #UtilityInvalidOverlay3  { Anchor: (Full: 0); Visible: false; Background: #220000(0.4); }
            }
            Button #UtilitySlot4 { Anchor: (Width: 56, Height: 56); Style: @GearSlotStyle;
                ItemSlot #UtilityItem4 { Anchor: (Width: 48, Height: 48); ShowQualityBackground: true; ShowQuantity: false; }
                Group #UtilitySelectedOverlay4 { Anchor: (Full: 0); Visible: false; Background: @GearSlotSelectedBG; }
                Group #UtilityActiveOverlay4   { Anchor: (Full: 0); Visible: false; Background: @GearSlotActiveUtilityBG; }
                Group #UtilityValidOverlay4    { Anchor: (Full: 0); Visible: false; Background: #002200(0.4); }
                Group #UtilityInvalidOverlay4  { Anchor: (Full: 0); Visible: false; Background: #220000(0.4); }
            }
        }
    }

    // -------------------------------------------------------------------------
    // Separator between gear and inventory
    // -------------------------------------------------------------------------
    Group { Background: #9c8863(0.2); Anchor: (Height: 1, Bottom: 8); }

    // -------------------------------------------------------------------------
    // Storage grid — 36 slots in 4 rows of 9
    // -------------------------------------------------------------------------
    Group { LayoutMode: Left; Anchor: (Height: 76, Top: 0);
        Button #InvStorageSlot0  { Anchor: (Width: 74, Height: 74, Right: 2); Style: @InvSlotStyle; ItemSlot #InvStorageItem0  { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay0  { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay0  { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
        Button #InvStorageSlot1  { Anchor: (Width: 74, Height: 74, Right: 2); Style: @InvSlotStyle; ItemSlot #InvStorageItem1  { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay1  { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay1  { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
        Button #InvStorageSlot2  { Anchor: (Width: 74, Height: 74, Right: 2); Style: @InvSlotStyle; ItemSlot #InvStorageItem2  { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay2  { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay2  { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
        Button #InvStorageSlot3  { Anchor: (Width: 74, Height: 74, Right: 2); Style: @InvSlotStyle; ItemSlot #InvStorageItem3  { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay3  { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay3  { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
        Button #InvStorageSlot4  { Anchor: (Width: 74, Height: 74, Right: 2); Style: @InvSlotStyle; ItemSlot #InvStorageItem4  { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay4  { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay4  { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
        Button #InvStorageSlot5  { Anchor: (Width: 74, Height: 74, Right: 2); Style: @InvSlotStyle; ItemSlot #InvStorageItem5  { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay5  { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay5  { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
        Button #InvStorageSlot6  { Anchor: (Width: 74, Height: 74, Right: 2); Style: @InvSlotStyle; ItemSlot #InvStorageItem6  { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: true; } Group #InvStorageSelectedOverlay6  { Anchor: (Full: 0); Visible: false; Background: @InvSlotSelectedBackground; } Group #InvStorageInvalidOverlay6  { Anchor: (Full: 0); Visible: false; Background: #220000(0.5); } }
