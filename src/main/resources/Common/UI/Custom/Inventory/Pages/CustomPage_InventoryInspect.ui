$Common = "../../Common.ui";

@InspectPanel = Group {
    LayoutMode: Top;
    Anchor: (Width: 240);

    // -------------------------------------------------------------------------
    // Quick-craft grid — 2 rows x 3 columns
    // -------------------------------------------------------------------------
    Group {
        Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
        Anchor: (Bottom: 6);

        Group {
            LayoutMode: Top;
            Anchor: (Full: 8);

            // Row 1: slots 0, 1, 2
            Group {
                LayoutMode: Left;
                Anchor: (Height: 74, Bottom: 4);

                Button #QuickCraftSlot0 { Anchor: (Width: 74, Height: 74, Right: 4);
                    ItemSlot #QuickCraftItem0 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: false; }
                    Group #QuickCraftDimOverlay0 { Anchor: (Full: 0); Visible: false; Background: #000000(0.6); }
                }
                Button #QuickCraftSlot1 { Anchor: (Width: 74, Height: 74, Right: 4);
                    ItemSlot #QuickCraftItem1 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: false; }
                    Group #QuickCraftDimOverlay1 { Anchor: (Full: 0); Visible: false; Background: #000000(0.6); }
                }
                Button #QuickCraftSlot2 { Anchor: (Width: 74, Height: 74);
                    ItemSlot #QuickCraftItem2 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: false; }
                    Group #QuickCraftDimOverlay2 { Anchor: (Full: 0); Visible: false; Background: #000000(0.6); }
                }
            }

            // Row 2: slots 3, 4, 5
            Group {
                LayoutMode: Left;
                Anchor: (Height: 74);

                Button #QuickCraftSlot3 { Anchor: (Width: 74, Height: 74, Right: 4);
                    ItemSlot #QuickCraftItem3 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: false; }
                    Group #QuickCraftDimOverlay3 { Anchor: (Full: 0); Visible: false; Background: #000000(0.6); }
                }
                Button #QuickCraftSlot4 { Anchor: (Width: 74, Height: 74, Right: 4);
                    ItemSlot #QuickCraftItem4 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: false; }
                    Group #QuickCraftDimOverlay4 { Anchor: (Full: 0); Visible: false; Background: #000000(0.6); }
                }
                Button #QuickCraftSlot5 { Anchor: (Width: 74, Height: 74);
                    ItemSlot #QuickCraftItem5 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: false; }
                    Group #QuickCraftDimOverlay5 { Anchor: (Full: 0); Visible: false; Background: #000000(0.6); }
                }
            }
        }
    }

    // -------------------------------------------------------------------------
    // Inspect panel — unchanged
    // -------------------------------------------------------------------------
    Group {
        Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
        FlexWeight: 1;

        Group {
            LayoutMode: Top;
            Anchor: (Full: 0);

            Group #InspectEmpty {
                LayoutMode: Top;
                Anchor: (Full: 0);

                Label {
                    Text: "Select an item to inspect";
                    Style: (FontSize: 12, TextColor: #444444, Alignment: Center);
                    Anchor: (Full: 0);
                }
            }

            Group #InspectDetails {
                Visible: false;
                LayoutMode: Top;
                Anchor: (Full: 0);

                Group {
                    LayoutMode: Center;
                    Anchor: (Height: 80, Top: 10, Bottom: 6);

                    Group {
                        Anchor: (Width: 74, Height: 74);
                        ItemSlot #InspectItemIcon { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: false; }
                    }
                }

                Label #InspectItemName {
                    Style: (FontSize: 14, RenderBold: true, TextColor: #ffffff, Alignment: Center, Wrap: true);
                    Anchor: (Horizontal: 8, Bottom: 2);
                }
                Label #InspectItemRarity {
                    Style: (FontSize: 11, TextColor: #888888, Alignment: Center, RenderUppercase: true);
                    Anchor: (Horizontal: 8, Bottom: 8);
                }

                Group { Background: #9c8863(0.3); Anchor: (Height: 1, Horizontal: 8, Bottom: 8); }

                Group {
                    LayoutMode: TopScrolling;
                    FlexWeight: 1;
                    Anchor: (Horizontal: 0);

                    Group {
                        LayoutMode: Top;
                        Anchor: (Horizontal: 10, Top: 4, Bottom: 8);

                        Group { LayoutMode: Left; Anchor: (Bottom: 6);
                            Label { Text: "Gear Score"; Style: (FontSize: 12, TextColor: #888888); FlexWeight: 1; }
                            Label #InspectGearScore { Style: (FontSize: 12, TextColor: #c8a84b, RenderBold: true); Anchor: (Width: 60); }
                        }

                        Group #InspectWeaponDamageRow {
                            Visible: false;
                            LayoutMode: Left;
                            Anchor: (Bottom: 2);
                            Label #InspectWeaponDamageLabel { Style: (FontSize: 13, TextColor: #ffffff, RenderBold: true); FlexWeight: 1; }
                        }

                        Group #InspectImplicitSeparator { Visible: false; Background: #9c8863(0.15); Anchor: (Height: 1, Top: 6, Bottom: 6); }

                        Label #InspectImplicit1 { Visible: false; Style: (FontSize: 12, TextColor: #aaaaaa, Wrap: true); Anchor: (Bottom: 3); }
                        Label #InspectImplicit2 { Visible: false; Style: (FontSize: 12, TextColor: #aaaaaa, Wrap: true); Anchor: (Bottom: 3); }
                        Label #InspectImplicit3 { Visible: false; Style: (FontSize: 12, TextColor: #aaaaaa, Wrap: true); Anchor: (Bottom: 3); }
                        Label #InspectImplicit4 { Visible: false; Style: (FontSize: 12, TextColor: #aaaaaa, Wrap: true); Anchor: (Bottom: 3); }
                        Label #InspectImplicit5 { Visible: false; Style: (FontSize: 12, TextColor: #aaaaaa, Wrap: true); Anchor: (Bottom: 3); }

                        Group #InspectAffixSeparator { Visible: false; Background: #9c8863(0.15); Anchor: (Height: 1, Top: 6, Bottom: 6); }

                        Label #InspectAffix1 { Visible: false; Style: (FontSize: 12, TextColor: #bca57a, Wrap: true); Anchor: (Bottom: 3); }
                        Label #InspectAffix2 { Visible: false; Style: (FontSize: 12, TextColor: #bca57a, Wrap: true); Anchor: (Bottom: 3); }
                        Label #InspectAffix3 { Visible: false; Style: (FontSize: 12, TextColor: #bca57a, Wrap: true); Anchor: (Bottom: 3); }
                        Label #InspectAffix4 { Visible: false; Style: (FontSize: 12, TextColor: #bca57a, Wrap: true); Anchor: (Bottom: 3); }
                    }
                }
            }
        }
    }
};
