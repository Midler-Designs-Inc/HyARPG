@RoomCardSmallRoom = Group {
    LayoutMode: Top;
    Anchor: (Bottom: 8);

    Group {
        Background: #111a24;
        LayoutMode: Top;
        Anchor: (Horizontal: 0);

        Group { Anchor: (Height: 10); }

        Group {
            LayoutMode: Left;
            Anchor: (Horizontal: 12, Bottom: 4);
            Label {
                Text: "Small Room";
                Style: (FontSize: 15, RenderBold: true, TextColor: #cccccc);
                FlexWeight: 1;
            }
            Label {
                Text: "Tier 0";
                Style: (FontSize: 12, TextColor: #888888,  VerticalAlignment: Center);
                Anchor: (Width: 80);
            }
        }

        Label {
            Text: "Size: 3x3x3 – 5x5x5";
            Style: (FontSize: 11, TextColor: #666666);
            Anchor: (Horizontal: 12, Bottom: 6);
        }

        Group { Background: #2a3a4a; Anchor: (Height: 1, Horizontal: 12, Bottom: 8); }

        Group {
            LayoutMode: Left;
            Anchor: (Horizontal: 12, Bottom: 10);

            Group {
                LayoutMode: Top;
                FlexWeight: 1;
                Label { Text: "Buffs"; Style: (FontSize: 12, RenderBold: true, TextColor: #aaaaaa); Anchor: (Bottom: 4); }
                Label { Text: "Coming Soon!"; Style: (FontSize: 11, TextColor: #555555); }
            }

            Group { Anchor: (Width: 20); }

            Group {
                LayoutMode: Top;
                FlexWeight: 1;
                Label { Text: "Requirements"; Style: (FontSize: 12, RenderBold: true, TextColor: #aaaaaa); Anchor: (Bottom: 4); }
                Label { Text: "None"; Style: (FontSize: 11, TextColor: #cccccc); }
            }
        }
        Group { Anchor: (Height: 10); }
    }
};