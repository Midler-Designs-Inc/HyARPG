$Common = "../../Common.ui";

@InventorySlotBackground = (TexturePath: "../../Slot.png", Border: 3);
@InventorySlotSelectedBackground = (TexturePath: "../../ItemSlotSelected.png", Border: 3);
@InventorySlotStyle = (Default: (Background: @InventorySlotBackground), Hovered: (Background: @InventorySlotBackground), Pressed: (Background: @InventorySlotBackground));

@InventoryPanel = Group {
    LayoutMode: Top;
    Anchor: (Top: 8);

