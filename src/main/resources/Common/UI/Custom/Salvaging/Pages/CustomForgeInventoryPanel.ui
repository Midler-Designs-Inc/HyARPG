                       ItemSlot #HotbarItem8 { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: false; }
                       Group #HotbarSelectedOverlay8 { Anchor: (Full: 0); Visible: false; Background: @InventorySlotSelectedBackground; }
                       Group #HotbarInUseOverlay8 { Anchor: (Full: 0); Visible: false; Background: #000000(0.5); }
                       Group #HotbarInvalidOverlay8 { Anchor: (Full: 0); Visible: false; Background:#220000(0.5); }
                   }
               }
            }
        }
    }
};