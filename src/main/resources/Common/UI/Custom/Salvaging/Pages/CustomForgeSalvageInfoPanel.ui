$Common = "../../Common.ui";

@SalvageInfoPanel = Group {
    LayoutMode: Top;
    Anchor: (Width: 222, Left: 8);

    Group {
        Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
        FlexWeight: 1;

        Group {
            LayoutMode: Top;
            Anchor: (Full: 0);

            // descriptive label above input slot
            Label {
                Text: "Place gear to salvage";
                Style: (FontSize: 12, TextColor: #888888, Alignment: Center);
                Anchor: (Top: 8, Height: 20);
                Padding: (Horizontal: 8);
            }

            // single input slot centered
            Group {
                Anchor: (Height: 74, Top: 8, Horizontal: 0);
                LayoutMode: Center;

                Button #SalvageInputSlot {
                    Anchor: (Width: 74, Height: 74);
                    ItemSlot #SalvageInputItem { Anchor: (Width: 64, Height: 64); ShowQualityBackground: true; ShowQuantity: false; }
                    Group #SalvageInputOverlay { Anchor: (Full: 0); Visible: false; Background: #000000(0.5); }
                }
            }

            // weapon stats — only visible when input slot has an item
            Group #SalvageItemStats {
                Visible: false;
                LayoutMode: Top;
                Anchor: (Horizontal: 8, Top: 10);

                // separator
                Group {
                    Background: #9c8863(0.2);
                    Anchor: (Height: 1, Bottom: 6);
                }

                // item type and rarity e.g. "Axe (Rare)"
                Label #SalvageItemType {
                    Anchor: (Top: 6);
                    Style: (FontSize: 11, TextColor: #ffffff, RenderBold: true, RenderUppercase: true);
                }

                // base weapon damage
                Label #SalvageWeaponDamage {
                    Anchor: (Top: 2);
                    Style: (FontSize: 16, TextColor: #ffffff, RenderBold: true);
                }

                // separator before implicits
                Group {
                    Background: #9c8863(0.1);
                    Anchor: (Height: 1, Top: 8, Bottom: 4);
                }

                // implicit stat lines
                Label #SalvageImplicitLine1 { Anchor: (Top: 4); Style: (FontSize: 12, TextColor: #aaaaaa, Wrap: true); }
                Label #SalvageImplicitLine2 { Anchor: (Top: 3); Style: (FontSize: 12, TextColor: #aaaaaa, Wrap: true); }
                Label #SalvageImplicitLine3 { Anchor: (Top: 3); Style: (FontSize: 12, TextColor: #aaaaaa, Wrap: true); }
                Label #SalvageImplicitLine4 { Anchor: (Top: 3); Style: (FontSize: 12, TextColor: #aaaaaa, Wrap: true); }
                Label #SalvageImplicitLine5 { Anchor: (Top: 3); Style: (FontSize: 12, TextColor: #aaaaaa, Wrap: true); }

                // separator before affixes
                Group {
                    Background: #9c8863(0.1);
                    Anchor: (Height: 1, Top: 8, Bottom: 4);
                }

                // affix lines
                Label #SalvageAffixLine1 { Anchor: (Top: 4); Style: (FontSize: 12, TextColor: #bca57a, Wrap: true); }
                Label #SalvageAffixLine2 { Anchor: (Top: 3); Style: (FontSize: 12, TextColor: #bca57a, Wrap: true); }
                Label #SalvageAffixLine3 { Anchor: (Top: 3); Style: (FontSize: 12, TextColor: #bca57a, Wrap: true); }
                Label #SalvageAffixLine4 { Anchor: (Top: 3); Style: (FontSize: 12, TextColor: #bca57a, Wrap: true); }
            }

            Group { FlexWeight: 1; }

            $Common.@TextButton #SalvageButton {
                @Text = "SALVAGE";
                @Anchor = (Horizontal: 8, Bottom: 8);
                Disabled: true;
            }
        }
    }
};
