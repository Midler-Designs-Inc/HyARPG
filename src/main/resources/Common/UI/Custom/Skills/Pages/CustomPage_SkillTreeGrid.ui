$Common = "../../Common.ui";

@SkillTreeGrid = Group {
    FlexWeight: 1;
    LayoutMode: Top;

    // scrollable grid — explicit height, scrollbar matches other pages
    Group {
        Anchor: (Height: 700, Horizontal: 0, Top: 0);
        LayoutMode: TopScrolling;
        ScrollbarStyle: $Common.@DefaultScrollbarStyle;
        Padding: 10;

        Group {
            LayoutMode: Top;
            Padding: (Top: 10, Right: 10);

            // row 0
            Group {
                LayoutMode: Left;
                Anchor: (Height: 138, Bottom: 4);

                // cell R0C0 — always rendered so empty cells hold their space
                Button #NodeCellR0C0 {
                    Anchor: (Width: 80, Height: 138, Right: 4);
                    LayoutMode: Top;

                    // icon and lock overlay share the same fixed area
                    Group #NodeIconAreaR0C0 {
                        Anchor: (Width: 64, Height: 64, Top: 0);
                        Visible: false;

                        Group #NodeIconR0C0 { Anchor: (Full: 0); }

                        // lock overlay on top of icon
                        Group #NodeLockOverlayR0C0 {
                            Anchor: (Full: 0);
                            Visible: false;
                            Background: "../Icons/Skills_Locked_Overlay.png";
                        }
                    }

                    // rank label e.g. 3/10
                    Label #NodeRankLabelR0C0 {
                        Anchor: (Top: 2, Height: 16);
                        Visible: false;
                        Style: (FontSize: 11, TextColor: #aaaaaa, Alignment: Center);
                    }

                    // invest button
                    $Common.@SecondaryTextButton #NodePlusBtnR0C0 {
                        @Text = "+";
                        @Anchor = (Height: 24, Top: 2, Horizontal: 4);
                        Visible: false;
                    }

                    // Q button — ultimate ability equip
                    $Common.@SecondaryTextButton #NodeQBtnR0C0 {
                        @Text = "Q";
                        @Anchor = (Height: 24, Top: 2, Horizontal: 4);
                        Visible: false;
                    }

                    // E + R side by side — non-ultimate ability equip
                    Group #NodeERBtnsR0C0 {
                        Anchor: (Height: 24, Top: 10, Horizontal: 4);
                        LayoutMode: Left;
                        Visible: false;

                        $Common.@SecondaryTextButton #NodeEBtnR0C0 {
                            @Text = "E";
                            @Anchor = (Right: 2);
                            FlexWeight: 1;
                        }
                        $Common.@SecondaryTextButton #NodeRBtnR0C0 {
                            @Text = "R";
                            FlexWeight: 1;
                        }
                    }
                }

                // cell R0C1 — always rendered so empty cells hold their space
                Button #NodeCellR0C1 {
                    Anchor: (Width: 80, Height: 138, Right: 4);
                    LayoutMode: Top;

                    // icon and lock overlay share the same fixed area
