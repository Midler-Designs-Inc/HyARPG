$Common = "../../Common.ui";

@SkillTreeNav = Group {
    Anchor: (Width: 190);
    LayoutMode: Top;
    Background: #0d141c;

    // skill points — label and value inline on the same row
    Group {
        Anchor: (Height: 36, Top: 0);
        LayoutMode: Left;
        Padding: (Left: 10, Top: 0);

        Label {
            Text: "Skill Points:";
            Style: (FontSize: 11, TextColor: #888888, VerticalAlignment: Center);
            Anchor: (Height: 36);
        }
        Label #SkillPointsLabel {
            Anchor: (Height: 36, Left: 6);
            Style: (FontSize: 14, TextColor: #c8a84b, RenderBold: true, VerticalAlignment: Center);
        }
    }

    // separator
    Group { Background: #9c8863(0.3); Anchor: (Height: 1); }

    // scrollable tree list
    Group {
        FlexWeight: 1;
        LayoutMode: TopScrolling;

        Group {
            LayoutMode: Top;
            Padding: (Left: 8, Top: 6, Right: 8);

            // nav slot 0
            Group #NavSlot0 {
                Anchor: (Height: 36, Bottom: 4);
                Visible: false;

                // active highlight
                Group #NavActiveHighlight0 {
                    Anchor: (Full: 0);
                    Visible: false;
                    Background: #1e3a5f;
                }

                Button #NavBtn0 {
                    Anchor: (Full: 0);
                    Label #NavBtnLabel0 {
                        Anchor: (Full: 0);
                        Style: (FontSize: 12, TextColor: #cccccc, Alignment: Center, VerticalAlignment: Center);
                    }
                }
            }

