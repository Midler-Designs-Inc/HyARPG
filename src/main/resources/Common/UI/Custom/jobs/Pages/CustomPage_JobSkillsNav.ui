$Common = "../../Common.ui";

@JobSkillsNav = Group {
    Anchor: (Width: 190);
    LayoutMode: Top;
    Background: #0d141c;

    // separator at top
    Group { Background: #9c8863(0.3); Anchor: (Height: 1); }

    // fixed job list — 13 jobs, each showing name, level, and XP
    Group {
        LayoutMode: Top;
        Padding: (Left: 8, Top: 6, Right: 8);

        // job 0
        Group #JobNavSlot0 {
            Anchor: (Height: 48, Bottom: 4);

            Group #JobNavHighlight0 {
                Anchor: (Full: 0);
                Visible: false;
                Background: #1e3a5f;
            }

            Button #JobNavBtn0 {
                Anchor: (Full: 0);
                LayoutMode: Top;
                Padding: (Left: 10, Right: 10, Top: 4, Bottom: 4);

                Label #JobNavLabel0 {
                    Anchor: (Height: 18);
                    Style: (FontSize: 14, TextColor: #cccccc);
                }

                Group {
                    Anchor: (Height: 16);
                    LayoutMode: Left;

                    Label #JobNavLevelLabel0 {
                        FlexWeight: 1;
                        Style: (FontSize: 12, TextColor: #c8a84b);
                    }
                    Label #JobNavXpLabel0 {
                        Style: (FontSize: 12, TextColor: #888888);
                    }
                }
            }
        }

        // job 1
        Group #JobNavSlot1 {
            Anchor: (Height: 48, Bottom: 4);

