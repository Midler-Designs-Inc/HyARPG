$Common = "../../Common.ui";

@JobSkillsPerks = Group {
    FlexWeight: 1;
    LayoutMode: Top;

    // job description shown above the perk list
    Group {
        Padding: (Left: 16, Right: 16, Top: 6, Bottom: 6);

        Label #JobDescriptionLabel {
            Anchor: (Full: 0);
            Style: (FontSize: 14, TextColor: #ffffff, Wrap: true);
        }
    }

    // Separator between gear and inventory
    Group { Background: #9c8863(0.2); Anchor: (Height: 1, Bottom: 1); }

    // scrollable perk list
    Group {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $Common.@DefaultScrollbarStyle;
        Padding: (Left: 12, Right: 12, Top: 8, Bottom: 8);

        Group {
            LayoutMode: Top;

            // perk row 0
            Group #PerkRow0 {
                Anchor: (Height: 72, Bottom: 6);
                LayoutMode: Left;
                Visible: false;

                Group {
                    FlexWeight: 1;
                    LayoutMode: Top;
                    Padding: (Left: 12, Top: 8, Right: 12, Bottom: 8);

                    Label #PerkName0 {
                        Anchor: (Height: 18);
                        Style: (FontSize: 16, TextColor: #dddddd, RenderBold: true);
                    }
                    Label #PerkDesc0 {
                        FlexWeight: 1;
                        Style: (FontSize: 14, TextColor: #888888);
                    }
                }

                Group #PerkBadge0 {
                    Anchor: (Width: 72, Height: 72);
                    Background: #0d141c;

                    Label #PerkLevel0 {
                        Anchor: (Full: 0);
                        Style: (FontSize: 28, TextColor: #c8a84b, RenderBold: true, Alignment: Center, VerticalAlignment: Center);
                    }
                }
            }

            // perk row 1
            Group #PerkRow1 {
                Anchor: (Height: 72, Bottom: 6);
                LayoutMode: Left;
                Visible: false;

                Group {
                    FlexWeight: 1;
                    LayoutMode: Top;
                    Padding: (Left: 12, Top: 8, Right: 12, Bottom: 8);

                    Label #PerkName1 { Anchor: (Height: 18); Style: (FontSize: 16, TextColor: #dddddd, RenderBold: true); }
                    Label #PerkDesc1 { FlexWeight: 1; Style: (FontSize: 14, TextColor: #888888); }
                }

                Group #PerkBadge1 {
                    Anchor: (Width: 72, Height: 72);
                    Background: #0d141c;
                    Label #PerkLevel1 { Anchor: (Full: 0); Style: (FontSize: 28, TextColor: #c8a84b, RenderBold: true, Alignment: Center, VerticalAlignment: Center); }
                }
            }

